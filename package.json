    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "wechat",
    "sticker",
    "emoji",
    "send"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikunkol-hub/dsh-wechat-send.git"
  },
  "homepage": "https://github.com/mikunkol-hub/dsh-wechat-send#readme",
  "bugs": {
    "url": "https://github.com/mikunkol-hub/dsh-wechat-send/issues"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  }
}
